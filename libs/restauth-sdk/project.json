{
    "name": "restauth-sdk",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "sourceRoot": "libs/restauth-sdk/src",
    "projectType": "library",
    "tags": [],
    "targets": {
        "build": {
            "executor": "@nx/rollup:rollup",
            "outputs": [
                "{options.outputPath}"
            ],
            "options": {
                "outputPath": "dist/libs/restauth-sdk",
                "tsConfig": "libs/restauth-sdk/tsconfig.lib.json",
                "main": "libs/restauth-sdk/src/index.ts",
                "format": [
                    "cjs",
                    "esm"
                ],
                "generatePackageJson": true,
                "generateExportsField": true,
                "assets": [
                    {
                        "glob": "README.md",
                        "input": "libs/restauth-sdk",
                        "output": "."
                    }
                ]
            }
        }
    }
}
