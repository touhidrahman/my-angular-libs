{
    "name": "ngx-common",
    "$schema": "../../node_modules/nx/schemas/project-schema.json",
    "projectType": "library",
    "sourceRoot": "libs/ngx-common/src",
    "prefix": "lib",
    "targets": {
        "build": {
            "executor": "@angular/build:ng-packagr",
            "outputs": ["{workspaceRoot}/dist/libs/ngx-common"],
            "options": {
                "project": "libs/ngx-common/ng-package.json"
            },
            "configurations": {
                "production": {
                    "tsConfig": "libs/ngx-common/tsconfig.lib.prod.json"
                },
                "development": {
                    "tsConfig": "libs/ngx-common/tsconfig.lib.json"
                }
            },
            "defaultConfiguration": "production"
        },
        "test": {
            "executor": "@angular/build:unit-test",
            "options": {
                "tsConfig": "libs/ngx-common/tsconfig.spec.json"
            }
        }
    }
}
